# EchoRoom Environment Variables
# Copy to .env and fill in values. Never commit .env.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=                          # openssl rand -hex 32

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=                   # choose a strong password
DATABASE_URL=postgresql+asyncpg://echoroom:{POSTGRES_PASSWORD}@localhost:5432/echoroom
# Railway provides postgres:// or postgresql:// — the app normalises it automatically.

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
<<<<<<< HEAD

# ── CORS (JSON array of allowed origins) ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
# Production example: CORS_ORIGINS=["https://your-app.vercel.app"]

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=                      # sk-... (optional)
GEMINI_API_KEY=                      # your Gemini API key

# ── NextAuth (shared between frontend and backend JWT validation) ──────────────
NEXTAUTH_SECRET=                     # openssl rand -hex 32  (same value in both)
NEXTAUTH_URL=http://localhost:3000   # production: https://your-app.vercel.app

# ── OAuth providers (frontend only — set in Vercel dashboard for production) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
