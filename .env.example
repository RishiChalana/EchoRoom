# EchoRoom Environment Variables
# Copy to .env and fill in values

ENVIRONMENT=development
SECRET_KEY=                          # openssl rand -hex 32
POSTGRES_PASSWORD=                   # choose a strong password
DATABASE_URL=postgresql+asyncpg://echoroom:{POSTGRES_PASSWORD}@localhost:5432/echoroom
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=                      # sk-... (add in Week 2)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]  # add your deployed domain here in production
