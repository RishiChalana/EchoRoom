# ─────────────────────────────────────────────────────────────────────────────
# EchoRoom Frontend — Production Environment
# Safe to commit: no secrets here.
# Secrets (NEXTAUTH_SECRET, GOOGLE_CLIENT_ID/SECRET, GITHUB_CLIENT_ID/SECRET)
# must be set in the Vercel dashboard → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Empty string → client-side fetch calls use relative URLs (/api/v1/...)
# Next.js rewrites (next.config.mjs) proxy them to Railway via INTERNAL_API_URL.
# Set INTERNAL_API_URL in the Vercel dashboard (it's used at build time).
NEXT_PUBLIC_API_URL=

# Replace with your actual Vercel deployment URL.
# Must also be set in the Vercel dashboard so it applies at runtime.
NEXTAUTH_URL=https://YOUR-PROJECT.vercel.app
